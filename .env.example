# Copy this file to .env.local and fill in the values.

# Base URL of the backend API, without a trailing slash.
# Left empty, requests go to this app's own /api routes. Sign in needs a real
# backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Optional. Sent to the backend as the X-Client-Code header when set.
# The backend must allow that header in its CORS settings.
# Keep empty for the Station Parfume backend: its CORS settings do not allow
# this header, so setting it breaks every request.
NEXT_PUBLIC_CLIENT_CODE=

# The shop's WhatsApp number for the "Tanya peracik" buttons.
# International format without + or spaces, e.g. 6281234567890.
# Left empty, the WhatsApp buttons are hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=